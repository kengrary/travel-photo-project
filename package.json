{
  "name": "travel-photo-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "自托管旅行照片地图：照片按 GPS 自动定位到省/市/县，在地图上回顾你的旅行足迹。照片全本地存储。",
  "license": "MIT",
  "author": "dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kengrary/travel-photo-project.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "bootstrap:geo": "node server/scripts/bootstrap-geo.js",
    "backup": "node server/scripts/backup.js",
    "build:exe": "node scripts/build-exe.js",
    "test": "node --test server/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "exifr": "^7.1.3",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "heic-decode": "^2.1.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0",
    "supercluster": "^9.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "maplibre-gl": "^4.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "supertest": "^7.2.2",
    "vite": "^5.4.0"
  }
}
